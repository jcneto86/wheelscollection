# ============================================================================
# Wheels Collection — Apache configuration for Hostinger shared hosting
#
# The app uses hash routing (#/settings, #/collection/:id), so no mod_rewrite
# fallback is required. This file adds compression, caching and basic security
# headers. Upload it to public_html/app/ together with the other files.
# ============================================================================

Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType application/wasm .wasm
AddType application/octet-stream .onnx
AddType text/javascript .mjs

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml
  AddOutputFilterByType DEFLATE application/wasm
</IfModule>

# ---------------------------------------------------------------------------
# Cache
#
# HTML and translation dictionaries are always revalidated so content updates
# appear immediately. JS and CSS are the application itself: they are also
# revalidated on every load (304 when unchanged), otherwise a deploy can leave
# the browser with a new controller.js next to an old app.js — which fails as
# "The requested module './app.js' does not provide an export named ...".
# Only icons and heavy model binaries keep a long cache.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <Files "firebase-config.js">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>

  <Files "sw.js">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </Files>

  <FilesMatch "\.(css|js|mjs)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(svg|png|ico|webp|woff2?)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  <FilesMatch "\.(wasm|onnx)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Basic security headers. A CSP is still omitted: the theme bootstrapper in
  # <head> is inline and Firebase/Tesseract need cross-origin connections.
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"

  # Some shared hosts inject a Permissions-Policy advertising Chrome features
  # that no longer exist ("browsing-topics", "run-ad-auction",
  # "join-ad-interest-group"), which logs a console warning on every page load.
  # Drop their copy (both the normal and the "always" table) and declare only
  # what this app uses.
  Header always unset Permissions-Policy
  Header unset Permissions-Policy
  Header set Permissions-Policy "camera=(self), microphone=(), geolocation=()"

  Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
</IfModule>

# ---------------------------------------------------------------------------
# Do not expose local tooling or the generated build folder
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:tools|build|\.wheels)(?:/|$) - [F,L]
</IfModule>

# ---------------------------------------------------------------------------
# Do not expose deployment files or documentation
# ---------------------------------------------------------------------------
<FilesMatch "^(firebase\.json|firebase-debug\.log|firestore\.rules|firestore\.indexes\.json|README\.md|README\.pt-BR\.md|INTEGRACAO-CONTROLADOR\.md|plano-implementacao-imagem-ocr\.md|analise-ocr-hotwheels\.md|package\.json|package-lock\.json|tailwind\.config\.cjs|tailwind\.src\.css|wheels\.cmd|wheels\.sh|\.firebaserc|\.firebase.*|\.env.*|\.git.*|\.htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
